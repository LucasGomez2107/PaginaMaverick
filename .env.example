# Variables de entorno del servidor. Estos son los valores por defecto.

# Puerto donde escucha el servidor.
PORT=3000

# Ruta del archivo SQLite. En Render usá /var/data/mavs.db (con Persistent Disk).
DB_PATH=./data/mavs.db

# Usernames con permisos de admin, separados por coma (no distingue mayúsculas).
ADMIN_USERNAMES=MavSudamerica

# Con "production" la cookie de sesión es segura (solo HTTPS).
NODE_ENV=

# 0 desactiva la sincronización automática con ESPN.
ESPN_SYNC=1

# 0 evita cargar los datos de ejemplo.
SEED_DEMO=1
